#!/usr/bin/env sh
[ "${HUSKY-}" = "0" ] && exit 0
set -e

# Catalog → docs check pipeline.
#
# The hook only checks. It never regenerates a file, never stages and never
# commits: a hook that rewrites the index hides work from the committer, and a
# regenerator can change outputs the hook does not stage, so the commit then
# fails `npm run check-docs` in CI.
#
# Step 1: if any catalog INPUT is staged, verify that every generated output is
#         fresh. On drift, refuse the commit and tell the committer to run
#         `npm run generate-docs`, stage the changed files and commit again.
#
# Step 2: if any catalog-coupled file is staged (inputs OR outputs OR README),
#         run validate-catalog as the final guard. Catches manual edits to
#         marker-bounded regions and unknown `atomic-skills:<name>` mentions.
#
# Hand-edits to README.md outside markers and outside the lint regex are not
# touched by the generator — they survive across regenerate runs.

STAGED=$(git diff --cached --name-only)

# Inputs: catalog, skill bodies, IDE registry, package version, generator code.
INPUTS_REGEX='^(meta/catalog\.yaml|skills/(core|modules|shared)/|src/config\.js|package\.json|scripts/(validate-skills|generate-)|scripts/lib/(validate-skills-core|render-|extract-iron-law|build-catalog-json))'

# Coupled = inputs + outputs (README + the catalog.json projection).
COUPLED_REGEX='^(meta/catalog\.(yaml|json)|skills/(core|modules|shared)/|src/config\.js|package\.json|scripts/(validate-skills|generate-)|scripts/lib/(validate-skills-core|render-|extract-iron-law|build-catalog-json)|README\.md)'

if echo "$STAGED" | grep -qE "$INPUTS_REGEX"; then
  if ! npm run check-docs; then
    echo "[husky] ✖ generated docs are stale — run \`npm run generate-docs\`," >&2
    echo "[husky]   stage the changed files, then commit again." >&2
    exit 1
  fi
fi

if echo "$STAGED" | grep -qE "$COUPLED_REGEX"; then
  npm run validate-catalog
fi

bash scripts/qa.sh changed --staged
