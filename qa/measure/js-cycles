#!/usr/bin/env node
/**
 * Import cycles, stack `js`, metric `import-cycles`.
 *
 * Contract (see the comment block at the top of scripts/qa.sh):
 *   --describe  prints mode/changed/covers lines; exit 0
 *   (nothing)   measures the production roots src/, scripts/, bin/
 *   stdout      one line per item above its ceiling, nothing else
 *   exit 0      measured (even with items); 3 tool not installed
 *
 * madge reads the graph, `--circular --json` prints one array per cycle. The
 * key is `<first file in sorted order>::cycle><the other files, sorted,
 * comma separated>`, so a cycle keeps its name when the file order changes.
 * The repository root comes from QA_ROOT, or from git when it is not set.
 */

import { execFileSync, spawnSync } from 'node:child_process';
import { createRequire } from 'node:module';
import {
  existsSync, mkdtempSync, readFileSync, readdirSync, rmSync,
} from 'node:fs';
import { dirname, isAbsolute, join, relative, resolve, sep } from 'node:path';
import { tmpdir } from 'node:os';
import { parseJavaScript } from './lib/js-source.mjs';

const STACK = 'js';
const METRIC = 'import-cycles';
const ROOTS = ['src', 'scripts', 'bin'];
const EXTENSIONS = ['.js', '.mjs'];

const DESCRIBE = [
  'mode\tfast',
  'changed\tno',
  `covers\t${STACK}\t${METRIC}`,
].join('\n');

function fail(message) {
  process.stderr.write(`js-cycles: ${message}\n`);
  process.exit(1);
}

function toolMissing(message) {
  process.stderr.write(`js-cycles: ${message}\n`);
  process.exit(3);
}

function repositoryRoot() {
  if (process.env.QA_ROOT) return resolve(process.env.QA_ROOT);
  try {
    return execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();
  } catch {
    fail('not inside a git repository and QA_ROOT is not set');
  }
}

function readCeiling(root) {
  const path = join(root, 'qa', 'ceilings.tsv');
  let body;
  try {
    body = readFileSync(path, 'utf8');
  } catch {
    fail(`cannot read ${path}`);
  }
  for (const [number, line] of body.split(/\r?\n/).entries()) {
    if (!line.trim() || line.startsWith('#') || number === 0) continue;
    const [metric, ceiling] = line.split('\t');
    if (metric !== METRIC) continue;
    const value = Number(ceiling);
    if (!Number.isFinite(value)) fail(`${path}:${number + 1}: not a number: ${ceiling}`);
    return value;
  }
  return fail(`${path}: no ceiling for ${METRIC}`);
}

function relativeKey(root, file) {
  return relative(root, file).split(sep).join('/');
}

function isProductionKey(key) {
  return EXTENSIONS.some((extension) => key.endsWith(extension))
    && ROOTS.some((root) => key.startsWith(`${root}/`));
}

function loadMadge() {
  try {
    const require = createRequire(import.meta.url);
    const packagePath = require.resolve('madge/package.json');
    return join(dirname(packagePath), 'bin', 'cli.js');
  } catch (error) {
    return toolMissing(`madge is not installed: ${error.message}`);
  }
}

function loadEspree() {
  try {
    const require = createRequire(import.meta.url);
    return require('espree');
  } catch (error) {
    return toolMissing(`espree is not installed: ${error.message}`);
  }
}

function sourceFiles(directory, found) {
  let entries;
  try {
    entries = readdirSync(directory, { withFileTypes: true });
  } catch (error) {
    fail(`cannot read ${directory}: ${error.message}`);
  }
  for (const entry of entries) {
    const path = join(directory, entry.name);
    if (entry.isDirectory()) {
      if (entry.name === 'node_modules' || entry.name === '.git') continue;
      sourceFiles(path, found);
    } else if (entry.isFile() && EXTENSIONS.some((extension) => entry.name.endsWith(extension))) {
      found.push(path);
    }
  }
}

function validateSources(root, roots, espree) {
  const files = [];
  for (const name of roots) sourceFiles(join(root, name), files);
  for (const file of files) {
    const key = relativeKey(root, file);
    let source;
    try {
      source = readFileSync(file, 'utf8');
    } catch (error) {
      fail(`cannot read ${key}: ${error.message}`);
    }
    try {
      parseJavaScript(espree, source);
    } catch (error) {
      fail(`${key}: cannot parse: ${error.message}`);
    }
  }
}

function resolveCycleFile(root, file) {
  return isAbsolute(file) ? file : resolve(root, file);
}

function cycleKey(root, cycle) {
  const files = [...new Set(cycle)]
    .map((file) => relativeKey(root, resolveCycleFile(root, file)))
    .filter(isProductionKey)
    .sort();
  if (files.length < 1) return null;
  return `${files[0]}::cycle>${files.slice(1).join(',')}`;
}

function measure(root) {
  const ceiling = readCeiling(root);
  const roots = ROOTS.filter((name) => existsSync(join(root, name)));
  if (roots.length === 0) return [];

  const espree = loadEspree();
  validateSources(root, roots, espree);

  const madge = loadMadge();
  const work = mkdtempSync(join(tmpdir(), 'qa-js-cycles-'));
  const items = [];
  try {
    // Run madge outside the measured tree so `.madgerc` and
    // `package.json#madge` cannot exclude files. The explicit base directory
    // is what madge's JSON paths are relative to.
    const result = spawnSync(
      process.execPath,
      [
        madge,
        '--circular',
        '--json',
        '--extensions', 'js,mjs',
        '--no-spinner',
        '--basedir', root,
        ...roots.map((name) => join(root, name)),
      ],
      { cwd: work, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 },
    );
    if (result.error) fail(`cannot run madge: ${result.error.message}`);
    if (result.signal) fail(`madge was terminated by ${result.signal}`);
    if (result.status !== 0 && result.status !== 1) {
      fail(`madge exited ${result.status}: ${result.stderr.trim()}`);
    }

    let cycles;
    try {
      cycles = JSON.parse(result.stdout);
    } catch {
      fail(`madge did not print a JSON cycle list: ${result.stderr.trim() || result.stdout.trim()}`);
    }
    if (!Array.isArray(cycles)) fail('madge did not print an array of cycles');

    const seen = new Set();
    for (const cycle of cycles) {
      if (!Array.isArray(cycle)) fail('madge printed a cycle that is not an array');
      const key = cycleKey(root, cycle);
      if (!key || seen.has(key)) continue;
      seen.add(key);
      const value = 1;
      if (value > ceiling) items.push([STACK, METRIC, key, value]);
    }
    return items;
  } finally {
    rmSync(work, { recursive: true, force: true });
  }
}

function print(items) {
  const lines = items.map((item) => item.join('\t')).sort();
  if (lines.length) process.stdout.write(`${lines.join('\n')}\n`);
}

const args = process.argv.slice(2);
if (args.length === 1 && args[0] === '--describe') {
  process.stdout.write(`${DESCRIBE}\n`);
} else if (args.length > 0) {
  process.stderr.write('usage: js-cycles [--describe]\n');
  process.exit(1);
} else {
  print(measure(repositoryRoot()));
}
