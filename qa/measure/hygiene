#!/usr/bin/env node
/**
 * Suppression comments and secrets, stacks `js`, `py` and `sh`, metrics
 * `suppressions` and `secrets`.
 *
 * Contract (see the comment block at the top of scripts/qa.sh):
 *   --describe  prints mode/changed/covers lines; exit 0
 *   (nothing)   measures every stack root in qa/stacks.tsv
 *   --files F.. measures only the listed files, paths from the repository root
 *   stdout      one line per item above its ceiling, nothing else
 *   exit 0      measured (even with items); 3 tool not installed
 *
 * Suppressions are counted in comments only: espree is the source of comments
 * for JavaScript, and a small quote-aware scan finds the `#` comment for Python
 * and shell. Secrets are counted wherever they appear, because a real
 * credential in a string is still a credential.
 */

import { execFileSync, spawnSync } from 'node:child_process';
import { createRequire } from 'node:module';
import { readdirSync, readFileSync } from 'node:fs';
import { dirname, isAbsolute, join, relative, resolve, sep } from 'node:path';
import { SECRETS, SUPPRESSIONS } from './lib/hygiene-patterns.mjs';
import { parseJavaScript } from './lib/js-source.mjs';

const METRICS = ['suppressions', 'secrets'];
const STACKS = ['js', 'py', 'sh'];

const DESCRIBE = [
  'mode\tfast',
  'changed\tyes',
  ...STACKS.flatMap((stack) => METRICS.map((metric) => `covers\t${stack}\t${metric}`)),
].join('\n');

function fail(message) {
  process.stderr.write(`hygiene: ${message}\n`);
  process.exit(1);
}

function toolMissing(message) {
  process.stderr.write(`hygiene: ${message}\n`);
  process.exit(3);
}

function repositoryRoot() {
  if (process.env.QA_ROOT) return resolve(process.env.QA_ROOT);
  try {
    return execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();
  } catch {
    fail('not inside a git repository and QA_ROOT is not set');
  }
}

function readCeilings(root) {
  const path = join(root, 'qa', 'ceilings.tsv');
  let body;
  try {
    body = readFileSync(path, 'utf8');
  } catch {
    fail(`cannot read ${path}`);
  }
  const ceilings = {};
  for (const [number, line] of body.split(/\r?\n/).entries()) {
    if (!line.trim() || line.startsWith('#') || number === 0) continue;
    const [metric, ceiling] = line.split('\t');
    if (!METRICS.includes(metric)) continue;
    const value = Number(ceiling);
    if (!Number.isFinite(value)) fail(`${path}:${number + 1}: not a number: ${ceiling}`);
    ceilings[metric] = value;
  }
  for (const metric of METRICS) {
    if (!(metric in ceilings)) fail(`${path}: no ceiling for ${metric}`);
  }
  return ceilings;
}

function readStacks(root) {
  const path = join(root, 'qa', 'stacks.tsv');
  let body;
  try {
    body = readFileSync(path, 'utf8');
  } catch {
    fail(`cannot read ${path}`);
  }
  const stacks = [];
  for (const [number, line] of body.split(/\r?\n/).entries()) {
    if (!line.trim() || line.startsWith('#')) continue;
    const columns = line.split('\t');
    if (number === 0 && columns[0] === 'stack') continue;
    const [stack, language, roots = '', generated = ''] = columns;
    if (!STACKS.includes(stack)) continue;
    stacks.push({
      stack,
      language,
      roots: roots.split(',').map((item) => item.trim()).filter((item) => item && item !== '-'),
      generated: generated.split(',').map((item) => item.trim()).filter((item) => item && item !== '-'),
    });
  }
  return stacks;
}

function relativeKey(root, file) {
  return relative(root, file).split(sep).join('/');
}

function generated(key, prefixes) {
  return prefixes.some((prefix) => key.startsWith(`${prefix.replace(/\/+$/, '')}/`));
}

function included(stack, key, name) {
  if (stack === 'js') return name.endsWith('.js') || name.endsWith('.mjs');
  if (stack === 'py') return name.endsWith('.py');
  if (stack === 'sh') return name.endsWith('.sh') || key.startsWith('.husky/');
  return false;
}

function walk(directory, found, optional = false) {
  let entries;
  try {
    entries = readdirSync(directory, { withFileTypes: true });
  } catch (error) {
    if (optional && error.code === 'ENOENT') return;
    fail(`cannot read ${directory}: ${error.message}`);
  }
  for (const entry of entries) {
    const path = join(directory, entry.name);
    if (entry.isDirectory()) {
      if (entry.name === 'node_modules' || entry.name === '.git') continue;
      walk(path, found);
    } else if (entry.isFile()) {
      found.push(path);
    }
  }
}

function collect(root, stacks) {
  const files = new Map();
  for (const entry of stacks) {
    for (const name of entry.roots) {
      const found = [];
      walk(join(root, name), found, true);
      for (const file of found) {
        const key = relativeKey(root, file);
        if (generated(key, entry.generated)) continue;
        if (!included(entry.stack, key, file)) continue;
        if (!files.has(key)) files.set(key, entry.stack);
      }
    }
  }
  return files;
}

/**
 * Find shell comments while keeping quoting state across lines. Single and
 * double quotes, ANSI-C `$'...'` quoting, backticks and here-documents are
 * tracked, so a `#` inside a multiline string or a here-document body is data,
 * not a suppression directive.
 */
function shellComments(source) {
  const comments = [];
  const heredocs = [];
  let quote = null;
  let escaped = false;
  let arithmetic = 0;

  for (const line of source.split(/\r?\n/)) {
    if (heredocs.length > 0) {
      const heredoc = heredocs[0];
      const candidate = heredoc.stripTabs ? line.replace(/^\t+/, '') : line;
      if (candidate === heredoc.delimiter) heredocs.shift();
      continue;
    }

    let commentIndex = -1;
    for (let index = 0; index < line.length; index += 1) {
      const character = line[index];
      if (escaped) {
        escaped = false;
        continue;
      }
      if (arithmetic > 0) {
        if (character === '(') arithmetic += 1;
        else if (character === ')') arithmetic -= 1;
        continue;
      }
      if (quote) {
        if (quote === "'") {
          if (character === "'") quote = null;
        } else if (character === '\\') {
          escaped = true;
        } else if (character === quote || (quote === '$' && character === "'")) {
          quote = null;
        }
        continue;
      }
      if (character === '\\') {
        escaped = true;
        continue;
      }
      if (character === "'" || character === '"' || character === '`') {
        quote = character;
        continue;
      }
      if (character === '$' && line[index + 1] === "'") {
        quote = '$';
        index += 1;
        continue;
      }
      if (character === '(' && line[index + 1] === '(') {
        // $((...)) and ((...)) are arithmetic, where << is a shift.
        arithmetic = 2;
        index += 1;
        continue;
      }
      if (
        character === '#'
        && (index === 0 || /\s/.test(line[index - 1]) || ';|&()'.includes(line[index - 1]))
      ) {
        commentIndex = index;
        break;
      }
      if (
        character === '<'
        && line[index + 1] === '<'
        && line[index + 2] !== '<'
        && line[index + 2] !== '='
      ) {
        let cursor = index + 2;
        let stripTabs = false;
        if (line[cursor] === '-') {
          stripTabs = true;
          cursor += 1;
        }
        while (line[cursor] === ' ' || line[cursor] === '\t') cursor += 1;
        let delimiter = '';
        let delimiterQuote = null;
        for (; cursor < line.length; cursor += 1) {
          const part = line[cursor];
          if (delimiterQuote) {
            if (part === delimiterQuote) {
              delimiterQuote = null;
            } else if (part === '\\' && delimiterQuote === '"') {
              cursor += 1;
              delimiter += line[cursor] || '';
            } else {
              delimiter += part;
            }
            continue;
          }
          if (part === "'" || part === '"') {
            delimiterQuote = part;
            continue;
          }
          if (part === '\\') {
            cursor += 1;
            delimiter += line[cursor] || '';
            continue;
          }
          if (/\s/.test(part) || ';|&()<>'.includes(part)) break;
          delimiter += part;
        }
        if (delimiter) heredocs.push({ delimiter, stripTabs });
        index = Math.max(index, cursor - 1);
      }
    }
    if (commentIndex >= 0) comments.push(line.slice(commentIndex + 1));
    escaped = false;
  }
  return comments;
}

const PYTHON_COMMENTS = String.raw`
import json
import sys
import tokenize

result = {}
for path in sys.argv[1:]:
    try:
        with tokenize.open(path) as source:
            result[path] = [
                token.string
                for token in tokenize.generate_tokens(source.readline)
                if token.type == tokenize.COMMENT
            ]
    except (OSError, SyntaxError, tokenize.TokenError, UnicodeDecodeError) as error:
        print(f"{path}: {error}", file=sys.stderr)
        sys.exit(1)
json.dump(result, sys.stdout)
`;

function pythonComments(root, keys) {
  const paths = keys.map((key) => join(root, key));
  const result = spawnSync('python3', ['-c', PYTHON_COMMENTS, ...paths], {
    encoding: 'utf8',
    maxBuffer: 64 * 1024 * 1024,
  });
  if (result.error) {
    if (result.error.code === 'ENOENT') toolMissing('python3 is not installed');
    fail(`cannot run python3 to read comments: ${result.error.message}`);
  }
  if (result.signal) fail(`python3 was terminated by ${result.signal}`);
  if (result.status !== 0) {
    fail(`python3 could not tokenize comments: ${result.stderr.trim() || result.stdout.trim()}`);
  }
  let parsed;
  try {
    parsed = JSON.parse(result.stdout);
  } catch (error) {
    fail(`python3 printed invalid comment data: ${error.message}`);
  }
  return parsed;
}

function loadEspree() {
  try {
    const require = createRequire(import.meta.url);
    return require('espree');
  } catch (error) {
    return toolMissing(`espree is not installed: ${error.message}`);
  }
}

function jsComments(espree, source, file) {
  let ast;
  try {
    ast = parseJavaScript(espree, source, { comment: true });
  } catch (error) {
    fail(`${file}: cannot parse as a module or a script: ${error.message}`);
  }
  return (ast.comments || []).map((comment) => comment.value);
}

/**
 * Count directive occurrences without counting one directive twice when two
 * patterns overlap (for example `noqa` and `ruff: noqa`).
 */
function countOccurrences(texts, needles) {
  let total = 0;
  for (const text of texts) {
    const ranges = [];
    for (const needle of needles) {
      let index = text.indexOf(needle);
      while (index !== -1) {
        ranges.push([index, index + needle.length]);
        index = text.indexOf(needle, index + needle.length);
      }
    }
    ranges.sort((left, right) => left[0] - right[0]);
    let cursor = -1;
    for (const [start, end] of ranges) {
      if (start < cursor) continue;
      total += 1;
      cursor = end;
    }
  }
  return total;
}

function countSecrets(source) {
  let total = 0;
  for (const pattern of SECRETS) {
    const regex = new RegExp(pattern.source, pattern.flags);
    const found = source.match(regex);
    if (found) total += found.length;
  }
  return total;
}

function measure(root, files) {
  const ceilings = readCeilings(root);
  const stacks = readStacks(root);
  const all = collect(root, stacks);
  const known = files === null
    ? all
    : new Map([...all].filter(([key]) => files.has(key)));
  if (known.size === 0) return [];

  const espree = loadEspree();
  const pythonKeys = [...known].filter(([, stack]) => stack === 'py').map(([key]) => key);
  const python = pythonKeys.length > 0 ? pythonComments(root, pythonKeys) : {};
  const items = [];
  for (const [key, stack] of known) {
    let source;
    try {
      source = readFileSync(join(root, key), 'utf8');
    } catch (error) {
      fail(`cannot read ${key}: ${error.message}`);
    }
    let comments;
    if (stack === 'js') comments = jsComments(espree, source, key);
    else if (stack === 'py') comments = python[join(root, key)] || [];
    else comments = shellComments(source);
    const values = {
      suppressions: countOccurrences(comments, SUPPRESSIONS),
      secrets: countSecrets(source),
    };
    for (const metric of METRICS) {
      const value = values[metric];
      if (value > ceilings[metric]) items.push([stack, metric, `${key}::*`, value]);
    }
  }
  return items;
}

function normalize(root, files) {
  const keys = new Set();
  for (const file of files) {
    const absolute = resolve(root, file);
    const key = relativeKey(root, absolute);
    if (key.startsWith('..') || isAbsolute(key)) continue;
    keys.add(key);
  }
  return keys;
}

function print(items) {
  const lines = items.map((item) => item.join('\t')).sort();
  if (lines.length) process.stdout.write(`${lines.join('\n')}\n`);
}

const args = process.argv.slice(2);
if (args.length === 1 && args[0] === '--describe') {
  process.stdout.write(`${DESCRIBE}\n`);
} else if (args.length > 0 && args[0] === '--files') {
  const root = repositoryRoot();
  print(measure(root, normalize(root, args.slice(1))));
} else if (args.length > 0) {
  process.stderr.write('usage: hygiene [--describe | --files <path>...]\n');
  process.exit(1);
} else {
  print(measure(repositoryRoot(), null));
}
