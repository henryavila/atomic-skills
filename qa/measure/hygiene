#!/usr/bin/env node
/**
 * Suppression comments and secrets, stacks `js`, `py` and `sh`, metrics
 * `suppressions` and `secrets`.
 *
 * Contract (see the comment block at the top of scripts/qa.sh):
 *   --describe  prints mode/changed/covers lines; exit 0
 *   (nothing)   measures every stack root in qa/stacks.tsv
 *   --files F.. measures only the listed files, paths from the repository root
 *   stdout      one line per item above its ceiling, nothing else
 *   exit 0      measured (even with items); 3 tool not installed
 *
 * Suppressions are counted in comments only: espree is the source of comments
 * for JavaScript, and a small quote-aware scan finds the `#` comment for Python
 * and shell. Secrets are counted wherever they appear, because a real
 * credential in a string is still a credential.
 */

import { execFileSync } from 'node:child_process';
import { createRequire } from 'node:module';
import { readdirSync, readFileSync, statSync } from 'node:fs';
import { dirname, isAbsolute, join, relative, resolve, sep } from 'node:path';
import { SECRETS, SUPPRESSIONS } from './lib/hygiene-patterns.mjs';

const METRICS = ['suppressions', 'secrets'];
const STACKS = ['js', 'py', 'sh'];

const DESCRIBE = [
  'mode\tfast',
  'changed\tyes',
  ...STACKS.flatMap((stack) => METRICS.map((metric) => `covers\t${stack}\t${metric}`)),
].join('\n');

function fail(message) {
  process.stderr.write(`hygiene: ${message}\n`);
  process.exit(1);
}

function toolMissing(message) {
  process.stderr.write(`hygiene: ${message}\n`);
  process.exit(3);
}

function repositoryRoot() {
  if (process.env.QA_ROOT) return resolve(process.env.QA_ROOT);
  try {
    return execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();
  } catch {
    fail('not inside a git repository and QA_ROOT is not set');
  }
}

function readCeilings(root) {
  const path = join(root, 'qa', 'ceilings.tsv');
  let body;
  try {
    body = readFileSync(path, 'utf8');
  } catch {
    fail(`cannot read ${path}`);
  }
  const ceilings = {};
  for (const [number, line] of body.split(/\r?\n/).entries()) {
    if (!line.trim() || line.startsWith('#') || number === 0) continue;
    const [metric, ceiling] = line.split('\t');
    if (!METRICS.includes(metric)) continue;
    const value = Number(ceiling);
    if (!Number.isFinite(value)) fail(`${path}:${number + 1}: not a number: ${ceiling}`);
    ceilings[metric] = value;
  }
  for (const metric of METRICS) {
    if (!(metric in ceilings)) fail(`${path}: no ceiling for ${metric}`);
  }
  return ceilings;
}

function readStacks(root) {
  const path = join(root, 'qa', 'stacks.tsv');
  let body;
  try {
    body = readFileSync(path, 'utf8');
  } catch {
    fail(`cannot read ${path}`);
  }
  const stacks = [];
  for (const [number, line] of body.split(/\r?\n/).entries()) {
    if (!line.trim() || line.startsWith('#')) continue;
    const columns = line.split('\t');
    if (number === 0 && columns[0] === 'stack') continue;
    const [stack, language, roots = '', generated = ''] = columns;
    if (!STACKS.includes(stack)) continue;
    stacks.push({
      stack,
      language,
      roots: roots.split(',').map((item) => item.trim()).filter((item) => item && item !== '-'),
      generated: generated.split(',').map((item) => item.trim()).filter((item) => item && item !== '-'),
    });
  }
  return stacks;
}

function relativeKey(root, file) {
  return relative(root, file).split(sep).join('/');
}

function generated(key, prefixes) {
  return prefixes.some((prefix) => key.startsWith(`${prefix.replace(/\/+$/, '')}/`));
}

function included(stack, key, name) {
  if (stack === 'js') return name.endsWith('.js') || name.endsWith('.mjs');
  if (stack === 'py') return name.endsWith('.py');
  if (stack === 'sh') return name.endsWith('.sh') || key.startsWith('.husky/');
  return false;
}

function walk(directory, found) {
  let entries;
  try {
    entries = readdirSync(directory, { withFileTypes: true });
  } catch {
    return;
  }
  for (const entry of entries) {
    const path = join(directory, entry.name);
    if (entry.isDirectory()) {
      if (entry.name === 'node_modules' || entry.name === '.git') continue;
      walk(path, found);
    } else if (entry.isFile()) {
      found.push(path);
    }
  }
}

function collect(root, stacks) {
  const files = new Map();
  for (const entry of stacks) {
    for (const name of entry.roots) {
      const found = [];
      walk(join(root, name), found);
      for (const file of found) {
        const key = relativeKey(root, file);
        if (generated(key, entry.generated)) continue;
        if (!included(entry.stack, key, file)) continue;
        if (!files.has(key)) files.set(key, entry.stack);
      }
    }
  }
  return files;
}

function unquotedHash(line) {
  let quote = null;
  let escaped = false;
  for (let index = 0; index < line.length; index += 1) {
    const character = line[index];
    if (escaped) {
      escaped = false;
      continue;
    }
    if (quote) {
      if (character === '\\') escaped = true;
      else if (character === quote) quote = null;
      continue;
    }
    if (character === "'" || character === '"') {
      quote = character;
      continue;
    }
    if (character === '#') return index;
  }
  return -1;
}

function hashComments(source) {
  const comments = [];
  for (const line of source.split(/\r?\n/)) {
    const index = unquotedHash(line);
    if (index >= 0) comments.push(line.slice(index + 1));
  }
  return comments;
}

function loadEspree() {
  try {
    const require = createRequire(import.meta.url);
    return require('espree');
  } catch (error) {
    return toolMissing(`espree is not installed: ${error.message}`);
  }
}

function jsComments(espree, source) {
  try {
    const ast = espree.parse(source, {
      ecmaVersion: 'latest',
      sourceType: 'module',
      comment: true,
    });
    return (ast.comments || []).map((comment) => comment.value);
  } catch {
    return hashComments(source);
  }
}

function countOccurrences(texts, needles) {
  let total = 0;
  for (const text of texts) {
    for (const needle of needles) {
      let index = text.indexOf(needle);
      while (index !== -1) {
        total += 1;
        index = text.indexOf(needle, index + needle.length);
      }
    }
  }
  return total;
}

function countSecrets(source) {
  let total = 0;
  for (const pattern of SECRETS) {
    const regex = new RegExp(pattern.source, pattern.flags);
    const found = source.match(regex);
    if (found) total += found.length;
  }
  return total;
}

function measure(root, files) {
  const ceilings = readCeilings(root);
  const stacks = readStacks(root);
  const all = collect(root, stacks);
  const known = files === null
    ? all
    : new Map([...all].filter(([key]) => files.has(key)));
  if (known.size === 0) return [];

  const espree = loadEspree();
  const items = [];
  for (const [key, stack] of known) {
    const source = readFileSync(join(root, key), 'utf8');
    const comments = stack === 'js' ? jsComments(espree, source) : hashComments(source);
    const values = {
      suppressions: countOccurrences(comments, SUPPRESSIONS),
      secrets: countSecrets(source),
    };
    for (const metric of METRICS) {
      const value = values[metric];
      if (value > ceilings[metric]) items.push([stack, metric, `${key}::*`, value]);
    }
  }
  return items;
}

function normalize(root, files) {
  const keys = new Set();
  for (const file of files) {
    const absolute = resolve(root, file);
    const key = relativeKey(root, absolute);
    if (key.startsWith('..') || isAbsolute(key)) continue;
    keys.add(key);
  }
  return keys;
}

function print(items) {
  const lines = items.map((item) => item.join('\t')).sort();
  if (lines.length) process.stdout.write(`${lines.join('\n')}\n`);
}

const args = process.argv.slice(2);
if (args.length === 1 && args[0] === '--describe') {
  process.stdout.write(`${DESCRIBE}\n`);
} else if (args.length > 0 && args[0] === '--files') {
  const root = repositoryRoot();
  print(measure(root, normalize(root, args.slice(1))));
} else if (args.length > 0) {
  process.stderr.write('usage: hygiene [--describe | --files <path>...]\n');
  process.exit(1);
} else {
  print(measure(repositoryRoot(), null));
}
