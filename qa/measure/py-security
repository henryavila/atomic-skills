#!/usr/bin/env python3
"""Python static security findings, from bandit's JSON report.

Contract (see the comment block at the top of scripts/qa.sh):

  --describe   mode/changed/covers lines; exit 0
  (nothing)    run bandit over the python sources of the repository
  --files F..  measure only the listed files, paths from the repository root
  stdout       one line per item above its ceiling, nothing else
  exit 0       measured (even with items); 3 tool not installed

Only findings of severity MEDIUM or HIGH are kept, one item per function.
The tool is the ``bandit`` of ``qa/.venv`` next to this measurer's repository,
never one found on PATH; ``QA_VENV`` overrides that directory.

The converter (``--convert <report.json>``) is the test seam: it turns a
recorded bandit report into measure lines without running the tool.
"""

import ast
import json
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))

import pysymbols

STACK = "py"
METRIC = "static-security"
DESCRIBE = "mode\tfast\nchanged\tyes\ncovers\tpy\tstatic-security"
SKIP_DIRECTORIES = {"__pycache__", "node_modules", ".git"}
KEEP = ("MEDIUM", "HIGH")


def fail(message):
    sys.stderr.write("py-security: %s\n" % message)
    sys.exit(1)


def tool_missing(message):
    sys.stderr.write("py-security: %s\n" % message)
    sys.exit(3)


def repository_root():
    if os.environ.get("QA_ROOT"):
        return os.path.abspath(os.environ["QA_ROOT"])
    try:
        output = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], stderr=subprocess.DEVNULL
        )
    except (OSError, subprocess.CalledProcessError):
        fail("not inside a git repository and QA_ROOT is not set")
    return output.decode("utf-8").strip()


def venv_directory():
    if os.environ.get("QA_VENV"):
        return os.path.abspath(os.environ["QA_VENV"])
    repository = os.path.dirname(
        os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    )
    return os.path.join(repository, "qa", ".venv")


def find_tool(name):
    path = os.path.join(venv_directory(), "bin", name)
    if os.path.isfile(path) and os.access(path, os.X_OK):
        return path
    tool_missing("%s is not installed in %s — run scripts/qa.sh setup" % (name, venv_directory()))


def read_ceiling(root):
    path = os.path.join(root, "qa", "ceilings.tsv")
    try:
        handle = open(path, encoding="utf-8")
    except OSError:
        fail("cannot read %s" % path)
    with handle:
        for number, line in enumerate(handle, 1):
            line = line.rstrip("\n").rstrip("\r")
            if number == 1 or not line.strip() or line.startswith("#"):
                continue
            fields = line.split("\t")
            if fields[0] == METRIC:
                try:
                    return int(fields[1])
                except (IndexError, ValueError):
                    fail("%s:%d: not a number: %s" % (path, number, fields[1:]))
    fail("%s: no ceiling for %s" % (path, METRIC))


def read_roots(root):
    path = os.path.join(root, "qa", "stacks.tsv")
    try:
        handle = open(path, encoding="utf-8")
    except OSError:
        fail("cannot read %s" % path)
    with handle:
        for number, line in enumerate(handle, 1):
            line = line.rstrip("\n").rstrip("\r")
            if number == 1 or not line.strip() or line.startswith("#"):
                continue
            fields = line.split("\t")
            if fields[0] != STACK:
                continue
            raw = fields[2] if len(fields) > 2 else ""
            return [part.strip().rstrip("/") for part in raw.split(",") if part.strip() not in ("", "-")]
    fail("%s: no %s row" % (path, STACK))


def relative_key(root, path):
    return os.path.relpath(path, root).replace(os.sep, "/")


def walk(root, relative_dir, found):
    directory = os.path.join(root, relative_dir)
    if not os.path.isdir(directory):
        return
    for name in sorted(os.listdir(directory)):
        path = os.path.join(directory, name)
        if os.path.isdir(path):
            if name in SKIP_DIRECTORIES:
                continue
            walk(root, os.path.join(relative_dir, name), found)
        elif os.path.isfile(path) and name.endswith(".py"):
            found.add(relative_key(root, path))


def repository_files(root):
    found = set()
    for base in read_roots(root):
        walk(root, base, found)
    return sorted(found)


def listed_files(root, files, roots):
    found = set()
    for item in files:
        key = os.path.normpath(item).replace(os.sep, "/")
        if key.startswith("..") or os.path.isabs(key) or not key.endswith(".py"):
            continue
        if any(key == base or key.startswith(base + "/") for base in roots):
            found.add(key)
    return sorted(found)


def normalize(root, filename):
    if os.path.isabs(filename):
        path = os.path.relpath(os.path.realpath(filename), os.path.realpath(root))
    else:
        path = filename
    return os.path.normpath(path).replace(os.sep, "/")


def read_source(root, key):
    path = os.path.join(root, key)
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except OSError as error:
        fail("%s: cannot read: %s" % (key, error))


def check_errors(report):
    errors = report.get("errors") or []
    if not isinstance(errors, list):
        errors = [errors]
    if errors:
        details = "; ".join(
            "%s: %s" % (item.get("filename", "?"), item.get("reason", "?"))
            if isinstance(item, dict)
            else str(item)
            for item in errors
        )
        fail("bandit reported scan errors that make the measurement incomplete: %s" % details)


def convert(root, payload, ceiling, items):
    try:
        report = json.loads(payload)
    except ValueError as error:
        fail("cannot read the bandit report: %s" % error)

    check_errors(report)

    sources = {}
    counts = {}
    for result in report.get("results", []):
        severity = str(result.get("issue_severity", "")).upper()
        if severity not in KEEP:
            continue
        key = normalize(root, result.get("filename", ""))
        if key not in sources:
            source = read_source(root, key)
            try:
                tree = ast.parse(source, filename=key)
            except SyntaxError as error:
                fail("%s: cannot parse: %s" % (key, error))
            sources[key] = pysymbols.collect_functions(tree)
        symbol = pysymbols.symbol_at_line(sources[key], result.get("line_number", 0))
        slot = (key, symbol)
        counts[slot] = counts.get(slot, 0) + 1

    for (key, symbol), value in sorted(counts.items()):
        if value > ceiling:
            items.append([STACK, METRIC, "%s::%s" % (key, symbol), value])


def print_items(items):
    lines = ["\t".join(str(field) for field in item) for item in items]
    lines.sort()
    if lines:
        sys.stdout.write("\n".join(lines) + "\n")


def measure(root, keys, ceiling, items, tool):
    if not keys:
        return
    result = subprocess.run(
        [tool, "-q", "--ignore-nosec", "-f", "json"] + keys,
        cwd=root,
        capture_output=True,
        text=True,
    )
    if result.returncode not in (0, 1):
        fail("bandit exited %d: %s" % (result.returncode, result.stderr.strip()))
    if re.search(r"\bERROR\b", result.stderr):
        fail("bandit reported an internal error: %s" % result.stderr.strip())
    convert(root, result.stdout, ceiling, items)


def main():
    args = sys.argv[1:]
    if args == ["--describe"]:
        sys.stdout.write(DESCRIBE + "\n")
        return
    if len(args) == 2 and args[0] == "--convert":
        root = repository_root()
        ceiling = read_ceiling(root)
        try:
            with open(args[1], encoding="utf-8") as handle:
                payload = handle.read()
        except OSError as error:
            fail("cannot read %s: %s" % (args[1], error))
        items = []
        convert(root, payload, ceiling, items)
        print_items(items)
        return
    if len(args) > 0 and args[0] != "--files":
        sys.stderr.write("usage: py-security [--describe | --convert <report> | --files <path>...]\n")
        sys.exit(1)

    root = repository_root()
    tool = find_tool("bandit")
    ceiling = read_ceiling(root)
    if len(args) == 0:
        keys = repository_files(root)
    else:
        keys = listed_files(root, args[1:], read_roots(root))
    items = []
    measure(root, keys, ceiling, items, tool)
    print_items(items)


if __name__ == "__main__":
    main()
