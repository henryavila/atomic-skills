{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomic-skills.henryavila.com/schemas/flow.schema.json",
  "title": "atomic-skills Plan Flow (L1)",
  "description": "Canonical flow SoT at <planDir>/flow/flow.json. actors[] + graph (activity / xor / and / join / subprocess / event / end) + machines[]. See docs/design/project-flow/MODEL.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planSlug",
    "actor",
    "scenario",
    "audience",
    "actors",
    "graph",
    "machines"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "planSlug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "Who lives the flow (display string; not necessarily an actors[].id)"
    },
    "scenario": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence: what the actor wants to achieve"
    },
    "audience": {
      "type": "string",
      "enum": ["layperson", "developer", "both"]
    },
    "youAreHere": {
      "type": ["string", "null"],
      "description": "Optional pin on a graph or machine node id."
    },
    "ratifiedAt": {
      "type": "string",
      "minLength": 1,
      "description": "ISO timestamp written only by buildFlowRatification after show + AskUserQuestion"
    },
    "ratifiedBy": {
      "type": "string"
    },
    "ratifiedGraphSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "sha256 hex of the stamped document. Optional until stamped."
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "graph": { "$ref": "#/$defs/graph" },
    "machines": {
      "type": "array",
      "minItems": 1,
      "description": "All FSMs for the plan. At least one machine with at least one node.",
      "items": { "$ref": "#/$defs/machine" }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["actor", "participant"]
        }
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "branchId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.]*$"
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "nodes"],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "nodes": { "$ref": "#/$defs/nodeMap" },
        "subgraphs": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/subgraph" }
        }
      }
    },
    "subgraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "nodes"],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "nodes": { "$ref": "#/$defs/nodeMap" }
      }
    },
    "nodeMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/graphNode" }
    },
    "graphNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["activity", "xor", "and", "join", "subprocess", "event", "end"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "activity" } },
            "required": ["type"]
          },
          "then": { "$ref": "#/$defs/activityNode" }
        },
        {
          "if": {
            "properties": { "type": { "const": "xor" } },
            "required": ["type"]
          },
          "then": { "$ref": "#/$defs/xorNode" }
        },
        {
          "if": {
            "properties": { "type": { "const": "and" } },
            "required": ["type"]
          },
          "then": { "$ref": "#/$defs/andNode" }
        },
        {
          "if": {
            "properties": { "type": { "const": "join" } },
            "required": ["type"]
          },
          "then": { "$ref": "#/$defs/joinNode" }
        },
        {
          "if": {
            "properties": { "type": { "const": "subprocess" } },
            "required": ["type"]
          },
          "then": { "$ref": "#/$defs/subprocessNode" }
        },
        {
          "if": {
            "properties": { "type": { "const": "event" } },
            "required": ["type"]
          },
          "then": { "$ref": "#/$defs/eventNode" }
        },
        {
          "if": {
            "properties": { "type": { "const": "end" } },
            "required": ["type"]
          },
          "then": { "$ref": "#/$defs/endNode" }
        }
      ]
    },
    "activityNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "next"],
      "properties": {
        "type": { "const": "activity" },
        "label": { "type": "string", "minLength": 1 },
        "who": { "type": "string" },
        "title": { "type": "string" },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" }
        },
        "next": { "type": "string", "minLength": 1 }
      }
    },
    "xorNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "branches"],
      "properties": {
        "type": { "const": "xor" },
        "label": { "type": "string", "minLength": 1 },
        "who": { "type": "string" },
        "title": { "type": "string" },
        "question": { "type": "string" },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" }
        },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/xorBranch" }
        }
      }
    },
    "andNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "branches"],
      "properties": {
        "type": { "const": "and" },
        "label": { "type": "string", "minLength": 1 },
        "who": { "type": "string" },
        "title": { "type": "string" },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" }
        },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/andBranch" }
        }
      }
    },
    "joinNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "of", "next"],
      "properties": {
        "type": { "const": "join" },
        "label": { "type": "string", "minLength": 1 },
        "of": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "minLength": 1 },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" }
        }
      }
    },
    "subprocessNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "next"],
      "properties": {
        "type": { "const": "subprocess" },
        "label": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "minLength": 1 },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" }
        }
      }
    },
    "eventNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "next"],
      "properties": {
        "type": { "const": "event" },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["timer", "error"]
        },
        "next": { "type": "string", "minLength": 1 },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" }
        }
      }
    },
    "endNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "end" },
        "label": { "type": "string", "minLength": 1 },
        "title": { "type": "string" }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "text"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "async": { "type": "boolean" }
      }
    },
    "xorBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "label", "next"],
      "properties": {
        "id": { "$ref": "#/$defs/branchId" },
        "when": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "minLength": 1 }
      }
    },
    "andBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next"],
      "properties": {
        "id": { "$ref": "#/$defs/branchId" },
        "label": { "type": "string", "minLength": 1 },
        "next": { "type": "string", "minLength": 1 }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "entry", "nodes", "transitions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": { "$ref": "#/$defs/machineNode" }
        },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/machineTransition" }
        }
      }
    },
    "machineNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "terminal": { "type": "boolean" }
      }
    },
    "machineTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "when", "label", "effects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "via": { "type": "string", "minLength": 1 },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "target"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["email", "notify", "write", "other"]
        },
        "label": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    }
  }
}
