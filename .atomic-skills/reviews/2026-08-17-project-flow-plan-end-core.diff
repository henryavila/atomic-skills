+export function buildFlowHtml(raw, dsCss) {
+  const normalized = normalizeFlow(raw);
+  return {
+    html: renderFlowHtml(normalized, dsCss),
+    normalized,
+    contentSha: contentFingerprint(normalized),
+  };
+}
