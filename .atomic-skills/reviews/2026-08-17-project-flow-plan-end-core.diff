+  <span class="fl-msg-arrow" aria-hidden="true">→</span>
+  <span class="fl-msg-to">${escapeHtml(toLabel)}</span>
+  <p class="fl-msg-text">${escapeHtml(msg.text)}</p>
+</li>`;
+  })
+  .join('\n')}
+</ol>`;
+}
+
+function renderBpmNode(id, node) {
