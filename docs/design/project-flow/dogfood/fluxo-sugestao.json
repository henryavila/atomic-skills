{
  "schemaVersion": "1.0",
  "planSlug": "sugestao-necessidade-pdti",
  "title": "Sugestão de necessidade PDTI · interface",
  "description": "Fonte canônica do fluxo Nível 2. IDs técnicos (S1, D1…) são só para máquina/IA; o BPM usa label de negócio. Três XOR: validação do envio, edição pelo líder, aceite/recusa. Cliques e telas vivem só em messages[].",
  "scenario": "GETIN sugere uma necessidade PDTI e o líder da área aceita ou recusa.",
  "actor": "GETIN",
  "audience": "both",
  "actors": [
    {
      "id": "G",
      "label": "GETIN",
      "kind": "actor"
    },
    {
      "id": "App",
      "label": "Sistema",
      "kind": "participant"
    },
    {
      "id": "L",
      "label": "Líder",
      "kind": "actor"
    }
  ],
  "graph": {
    "entry": "S1",
    "nodes": {
      "S1": {
        "type": "activity",
        "title": "Criar sugestão",
        "label": "Criar sugestão",
        "who": "GETIN",
        "messages": [
          {
            "from": "G",
            "to": "App",
            "text": "Abre lista de solicitações PDTI",
            "async": false
          },
          {
            "from": "App",
            "to": "G",
            "text": "Mostra lista com ação Sugerir necessidade",
            "async": true
          },
          {
            "from": "G",
            "to": "App",
            "text": "Clica em Sugerir necessidade",
            "async": false
          },
          {
            "from": "App",
            "to": "G",
            "text": "Abre o formulário",
            "async": true
          },
          {
            "from": "G",
            "to": "App",
            "text": "Preenche e clica Enviar",
            "async": false
          },
          {
            "from": "App",
            "to": "App",
            "text": "Valida permissão, dados e líder da área",
            "async": false
          }
        ],
        "next": "D1"
      },
      "D1": {
        "type": "xor",
        "title": "Validação do envio",
        "label": "Envio válido?",
        "who": "Sistema",
        "question": "O envio é válido?",
        "branches": [
          {
            "id": "D1.fail",
            "when": "validacao_falhou",
            "label": "Envio inválido",
            "next": "S1e"
          },
          {
            "id": "D1.ok",
            "when": "validacao_ok",
            "label": "Envio válido",
            "next": "S1ok"
          }
        ]
      },
      "S1e": {
        "type": "activity",
        "title": "Corrigir envio inválido",
        "label": "Corrigir e reenviar",
        "who": "GETIN",
        "messages": [
          {
            "from": "App",
            "to": "G",
            "text": "Mostra erro (líder, dados ou permissão)",
            "async": true
          },
          {
            "from": "G",
            "to": "App",
            "text": "Ajusta os dados e clica Enviar de novo",
            "async": false
          },
          {
            "from": "App",
            "to": "App",
            "text": "Valida novamente",
            "async": false
          }
        ],
        "next": "D1"
      },
      "S1ok": {
        "type": "activity",
        "title": "Gravar sugestão pendente",
        "label": "Gravar como pendente",
        "who": "Sistema",
        "messages": [
          {
            "from": "App",
            "to": "App",
            "text": "Grava como pendente da área",
            "async": false
          },
          {
            "from": "App",
            "to": "G",
            "text": "Confirmação de sucesso",
            "async": true
          }
        ],
        "next": "S2"
      },
      "S2": {
        "type": "activity",
        "title": "Avisar o líder",
        "label": "Avisar o líder",
        "who": "Sistema",
        "messages": [
          {
            "from": "App",
            "to": "L",
            "text": "E-mail com resumo e botão Validar",
            "async": true
          }
        ],
        "next": "S3"
      },
      "S3": {
        "type": "activity",
        "title": "Validar a sugestão",
        "label": "Validar a sugestão",
        "who": "Líder",
        "messages": [
          {
            "from": "L",
            "to": "App",
            "text": "Clica em Validar no e-mail",
            "async": false
          },
          {
            "from": "App",
            "to": "L",
            "text": "Solicita login (se necessário)",
            "async": true
          },
          {
            "from": "App",
            "to": "L",
            "text": "Tela da sugestão pendente",
            "async": true
          }
        ],
        "next": "D_edit"
      },
      "D_edit": {
        "type": "xor",
        "title": "Edição do conteúdo",
        "label": "Editar o conteúdo?",
        "who": "Líder",
        "question": "O líder edita a sugestão antes de decidir?",
        "branches": [
          {
            "id": "D_edit.yes",
            "when": "lider_edita",
            "label": "Edita",
            "next": "S3edit"
          },
          {
            "id": "D_edit.no",
            "when": "segue_sem_editar",
            "label": "Não edita",
            "next": "D2"
          }
        ]
      },
      "S3edit": {
        "type": "activity",
        "title": "Atualizar o conteúdo",
        "label": "Atualizar o conteúdo",
        "who": "Líder",
        "messages": [
          {
            "from": "L",
            "to": "App",
            "text": "Edita campos e clica Salvar",
            "async": false
          },
          {
            "from": "App",
            "to": "L",
            "text": "Confirma conteúdo atualizado",
            "async": true
          }
        ],
        "next": "D2"
      },
      "D2": {
        "type": "xor",
        "title": "Resposta do líder",
        "label": "Aceitar ou recusar?",
        "who": "Líder",
        "question": "Aceitar ou recusar a sugestão?",
        "branches": [
          {
            "id": "D2.accept",
            "when": "lider_aceita",
            "label": "Aceita",
            "next": "S4a"
          },
          {
            "id": "D2.refuse",
            "when": "lider_recusa",
            "label": "Recusa",
            "next": "S4b"
          }
        ]
      },
      "S4a": {
        "type": "activity",
        "title": "Aceitar a sugestão",
        "label": "Aceitar e entrar no funil",
        "who": "Líder + Sistema + GETIN",
        "messages": [
          {
            "from": "L",
            "to": "App",
            "text": "Clica Aceitar",
            "async": false
          },
          {
            "from": "App",
            "to": "L",
            "text": "Modal Confirmar aceite?",
            "async": true
          },
          {
            "from": "L",
            "to": "App",
            "text": "Confirma no modal",
            "async": false
          },
          {
            "from": "App",
            "to": "App",
            "text": "Adota e vira solicitação no funil",
            "async": false
          },
          {
            "from": "App",
            "to": "L",
            "text": "Tela de sucesso",
            "async": true
          }
        ],
        "next": "end_accept"
      },
      "S4b": {
        "type": "activity",
        "title": "Recusar a sugestão",
        "label": "Recusar e avisar a GETIN",
        "who": "Líder + Sistema",
        "messages": [
          {
            "from": "L",
            "to": "App",
            "text": "Clica Recusar",
            "async": false
          },
          {
            "from": "App",
            "to": "L",
            "text": "Modal com motivo opcional",
            "async": true
          },
          {
            "from": "L",
            "to": "App",
            "text": "Confirma recusa no modal",
            "async": false
          },
          {
            "from": "App",
            "to": "App",
            "text": "Marca como recusada",
            "async": false
          },
          {
            "from": "App",
            "to": "L",
            "text": "Tela de confirmação",
            "async": true
          },
          {
            "from": "App",
            "to": "G",
            "text": "Notificação ou e-mail de recusa",
            "async": true
          }
        ],
        "next": "end_refuse"
      },
      "end_accept": {
        "type": "end",
        "title": "Fim · entrou no funil",
        "label": "Fim · no funil"
      },
      "end_refuse": {
        "type": "end",
        "title": "Fim · sem funil",
        "label": "Fim · sem funil"
      }
    }
  },
  "machines": [
    {
      "id": "sugestao",
      "label": "Sugestão PDTI",
      "entry": "rascunho",
      "nodes": {
        "rascunho": {
          "label": "Rascunho"
        },
        "pendente": {
          "label": "Pendente da área"
        },
        "ativo": {
          "label": "Ativa",
          "terminal": false
        },
        "recusada": {
          "label": "Recusada",
          "terminal": true
        }
      },
      "transitions": [
        {
          "id": "T_draft_loop",
          "from": "rascunho",
          "to": "rascunho",
          "when": "validacao_falhou",
          "label": "Envio inválido · corrige e reenvia",
          "via": "D1.fail",
          "effects": [
            {
              "kind": "notify",
              "label": "Mostra erro de envio",
              "target": "GETIN"
            }
          ]
        },
        {
          "id": "T_to_pending",
          "from": "rascunho",
          "to": "pendente",
          "when": "validacao_ok",
          "label": "Envio válido · grava pendente",
          "via": "D1.ok",
          "effects": [
            {
              "kind": "write",
              "label": "Grava como pendente da área",
              "target": "sugestao"
            }
          ]
        },
        {
          "id": "T_edit_pending",
          "from": "pendente",
          "to": "pendente",
          "when": "lider_edita",
          "label": "Líder atualiza o conteúdo · ainda pendente",
          "via": "D_edit.yes",
          "effects": [
            {
              "kind": "write",
              "label": "Atualiza o conteúdo",
              "target": "sugestao"
            }
          ]
        },
        {
          "id": "T_skip_edit",
          "from": "pendente",
          "to": "pendente",
          "when": "segue_sem_editar",
          "label": "Líder segue sem editar",
          "via": "D_edit.no",
          "effects": []
        },
        {
          "id": "T_aceita",
          "from": "pendente",
          "to": "ativo",
          "when": "lider_aceita",
          "label": "Líder aceita",
          "via": "D2.accept",
          "effects": [
            {
              "kind": "write",
              "label": "Adota e entra no funil",
              "target": "solicitacao"
            },
            {
              "kind": "email",
              "label": "Avisa a GETIN",
              "target": "GETIN"
            }
          ]
        },
        {
          "id": "T_refuse",
          "from": "pendente",
          "to": "recusada",
          "when": "lider_recusa",
          "label": "Líder recusa",
          "via": "D2.refuse",
          "effects": [
            {
              "kind": "email",
              "label": "Avisa a GETIN da recusa",
              "target": "GETIN"
            }
          ]
        }
      ]
    }
  ]
