{
  "name": "@henryavila/atomic-skills",
  "version": "2.0.0",
  "description": "Stop rewriting prompts. Install optimized developer skills in any AI IDE.",
  "type": "module",
  "bin": {
    "atomic-skills": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "skills/",
    "meta/",
    "README.md",
    "LICENSE",
    "assets/"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:hooks": "bash tests/hooks/pre-commit.test.sh",
    "new-skill": "node scripts/new-skill.js",
    "validate-skills": "node scripts/validate-skills.js",
    "generate-readme": "node scripts/generate-readme.js",
    "generate-skill-docs": "node scripts/generate-skill-docs.js",
    "generate-catalog-json": "node scripts/generate-catalog-json.js",
    "generate-site": "node scripts/generate-site.js",
    "check-site": "node scripts/generate-site.js --check",
    "generate-docs": "node scripts/generate-readme.js && node scripts/generate-skill-docs.js && node scripts/generate-catalog-json.js && node scripts/generate-site.js",
    "check-docs": "node scripts/generate-readme.js --check && node scripts/generate-skill-docs.js --check && node scripts/generate-catalog-json.js --check && node scripts/generate-site.js --check",
    "validate-catalog": "npm run validate-skills && npm run check-docs",
    "prepare": "husky && git config core.hooksPath .husky"
  },
  "keywords": [
    "ai",
    "skills",
    "prompts",
    "claude",
    "cursor",
    "antigravity",
    "agy",
    "codex",
    "copilot",
    "grok"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henryavila/atomic-skills.git"
  },
  "homepage": "https://atomic-skills.henryavila.com",
  "bugs": {
    "url": "https://github.com/henryavila/atomic-skills/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@henryavila/minimalist-installer": "github:henryavila/minimalist-installer#1565a58fb5e9b1e51da7aa75c9624dd170da8740",
    "@iarna/toml": "^2.2.5",
    "ajv": "^8.20.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
